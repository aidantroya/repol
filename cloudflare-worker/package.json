{
  "name": "repol-pdf-stamper",
  "version": "1.0.0",
  "description": "Cloudflare Worker para estampar pie de página cliqueable de RePol en PDFs",
  "main": "src/index.js",
  "scripts": {
    "build": "esbuild src/index.js --bundle --format=esm --target=es2022 --outfile=dist/index.js --minify",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "wrangler": "^3.0.0"
  }
}
